---
// Starlight has no `SidebarSublist` override slot, so the custom sublist is
// wired in here instead: this replaces starlight-sidebar-topics' Sidebar
// override (topic switcher) and Starlight's default Sidebar, swapping in our
// SidebarSublist (group icons, custom styling).
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import TopicsSidebar from 'starlight-sidebar-topics/components/Sidebar.astro';
import SidebarSublist from './SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<TopicsSidebar />

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
